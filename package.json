{
  "name": "agent",
  "version": "1.0.0",
  "description": "基于分层架构和插件化设计的智能 Agent 系统。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "python3 -m pytest test -q --ignore=test/browser --ignore=test/web-react && npm run web:test",
    "web:dev": "npm --prefix web-react run dev",
    "web:build": "npm --prefix web-react run build",
    "web:typecheck": "npm --prefix web-react run typecheck",
    "web:lint": "npm --prefix web-react run lint",
    "web:test": "npm --prefix web-react run test",
    "security:check": "python3 scripts/audit_repository.py --check-index",
    "web:test:browser": "python3 scripts/validate_roadmap.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super-213/claw-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/super-213/claw-agent/issues"
  },
  "homepage": "https://github.com/super-213/claw-agent#readme",
  "devDependencies": {
    "jsdom": "^27.0.1"
  }
}

# API 配置
DASHSCOPE_API_KEY=your_api_key_here
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
# 留空使用 MODEL_NAME 指定的主模型；主模型不支持图片时才需单独指定视觉模型
VISION_MODEL=

# 应用配置
AGENT_FILE=Agent.md
SKILLS_DIR=skills
TIMEOUT=30
MAX_RETRIES=3
CONVERSATION_DIR=.data/conversations
RUN_DIR=.data/runs
# Agent 累计执行预算：0 表示不限制
AGENT_MAX_STEPS=0
AGENT_MAX_RUNTIME_SECONDS=0
AGENT_MAX_TOKENS=0
AGENT_MAX_COST=0
TOOL_OUTPUT_MAX_CHARS=12000

# 家庭事项：通过查询/工作台查看，默认不主动通知
HOME_DATA_DIR=.data/home
HOME_TIMEZONE=Asia/Shanghai
HOME_REMINDER_DELIVERY_ENABLED=false

# PWA 回复完成通知：填真实的运维联系邮箱或公开 HTTPS 联系页面后可开启
# 与家庭事项提醒开关独立；用户还需在主屏幕 Web App 中主动允许通知
WEB_PUSH_SUBJECT=
# 公私钥同时留空时，会在 HOME_DATA_DIR 自动生成并保留 VAPID 私钥
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Modern web upgrades: external tools and passkeys are explicitly opt-in.
# Use a reviewed config/mcp.toml copied from config/mcp.example.toml.
MCP_CONFIG=
PASSKEY_ENABLED=false
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
# Enable with HTTPS in production; localhost HTTP development may leave false.
AUTH_COOKIE_SECURE=false

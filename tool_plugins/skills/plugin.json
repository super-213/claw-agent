{
  "id": "skills",
  "version": "1.0.0",
  "api_version": 1,
  "entrypoint": "plugin.py:create_plugin",
  "runtimes": [
    "web",
    "cli"
  ],
  "requires_services": [
    "skills",
    "registry"
  ],
  "requested_permissions": [
    "skill:read",
    "skill:install",
    "network:public-read"
  ],
  "optional_tools": true,
  "tool_metadata": {
    "skill_load": {
      "group": "other",
      "keywords": []
    },
    "skill_install": {
      "group": "other",
      "keywords": [
        "skill",
        "安装",
        "技能",
        "链接",
        "GitHub"
      ]
    }
  },
  "aliases": {
    "skill.load": "skill_load",
    "skill.install": "skill_install"
  },
  "optional_services": [
    "skill_installer"
  ]
}
